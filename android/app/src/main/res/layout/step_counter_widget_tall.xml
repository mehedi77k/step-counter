<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAILY ACTIVITY"
        android:textStyle="bold"
        android:textColor="#6E6A93"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_steps_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="8,432"
        android:textStyle="bold"
        android:textColor="#3348E8"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/widget_goal_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/10,000"
        android:textColor="#43406A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="84%"
        android:textColor="#3348E8"
        android:textStyle="bold"
        android:textSize="24sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="84"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_calories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="412 kcal"
            android:textColor="#46426F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="6.2 km"
            android:textColor="#46426F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="54 min"
            android:textColor="#46426F"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_btn_start"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="OPEN APP"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="11sp"
        android:background="@drawable/widget_btn_primary_bg" />

    <TextView
        android:id="@+id/widget_btn_water"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
